## Database
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

## Backend
API_PORT=5284

# Address of the database, using the compose service name
DATABASE_ADDRESS=db
# if running the database outside of the compose compose
# network, use the address of the host machine with
# DATABASE_ADDRESS=host.docker.internal
# if running the backend locally use the host machine's address
# this will need to be set in the sub-directories .env since
# this .env is not loaded when running the backend locally
# DATABASE_ADDRESS=localhost:5432

## Frontend
FRONTEND_PORT=5173

# Address of the private api called by the server
# using the compose service name
API_PRIVATE_ADDRESS=api:5284
# if running the api locally address the host machine with
# API_PRIVATE_ADDRESS=host.docker.internal:5284
# if running the frontend locally use the host machine's address
# this will need to be set in the sub-directories .env since
# this .env is not loaded when running the frontend locally
# API_PRIVATE_ADDRESS=localhost:5284

# Address of the public api called by clients
API_PUBLIC_ADDRESS=localhost:5284